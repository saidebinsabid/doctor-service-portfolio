##############################################
#  প্রফেসর ডা. আবু সুফিয়ান — কনফিগারেশন
#  এই ফাইল কপি করে .env নাম দিন, তারপর মান বসান
##############################################

APP_NAME="প্রফেসর ডা. আবু সুফিয়ান"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ⚠️ বাংলাদেশ সময় — বুকিংয়ের সময় ঠিক রাখতে অপরিহার্য
APP_TIMEZONE=Asia/Dhaka

# বাংলা ডিফল্ট ভাষা
APP_LOCALE=bn
APP_FALLBACK_LOCALE=bn
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

##############################################
#  ডাটাবেস
##############################################
# লোকাল ডেভেলপমেন্ট — SQLite, কোনো সার্ভার লাগে না
DB_CONNECTION=sqlite

# প্রোডাকশনে (cPanel হোস্টিং) — উপরের লাইনটি মুছে নিচেরগুলো চালু করুন:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=drabusufian
# DB_USERNAME=
# DB_PASSWORD=

##############################################
#  সেশন, ক্যাশ, কিউ
##############################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

##############################################
#  ইমেইল
##############################################
# লোকালে log ড্রাইভার — মেইল storage/logs/laravel.log এ লেখা হয়, পাঠানো হয় না
MAIL_MAILER=log

# প্রোডাকশনে cPanel ইমেইল ব্যবহার করলে:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.drabusufian.com
# MAIL_PORT=587
# MAIL_USERNAME=appointment@drabusufian.com
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="appointment@drabusufian.com"
MAIL_FROM_NAME="${APP_NAME}"

# নতুন বুকিং হলে যে ঠিকানায় জানানো হবে
ADMIN_NOTIFY_EMAIL=appointment@drabusufian.com

##############################################
#  নোটিফিকেশন চ্যানেল
##############################################
# Phase 1 (ফ্রি): wa_link — রোগী নিজে Send চাপেন
# Phase 2 (পেইড): cloud_api — সার্ভার থেকে স্বয়ংক্রিয় বার্তা
WHATSAPP_CHANNEL=wa_link

# চেম্বারের WhatsApp নম্বর (আন্তর্জাতিক ফরম্যাট, + ছাড়া)
WHATSAPP_NUMBER=8801327804433

# --- Phase 2 চালু করলে তখন লাগবে ---
# ⚠️ Cloud API-র নম্বর সাধারণ WhatsApp অ্যাপে ব্যবহৃত নম্বর হতে পারবে না।
#    01327804433 অ্যাপে চালু আছে, তাই আলাদা সিম লাগবে।
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TEMPLATE_CONFIRM=appointment_confirmation
# WHATSAPP_TEMPLATE_REMINDER=appointment_reminder

# SMS গেটওয়ে (ঐচ্ছিক, পেইড) — বাংলাদেশি প্রোভাইডার
SMS_ENABLED=false
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

##############################################
#  বুকিং নিয়ম
##############################################
# কত দিন পর্যন্ত আগাম বুকিং করা যাবে
BOOKING_ADVANCE_DAYS=30
# আজকের দিনে স্লট বন্ধ হবে কত মিনিট আগে
BOOKING_CUTOFF_MINUTES=30
# একই মোবাইল নম্বর থেকে দিনে সর্বোচ্চ কয়টি বুকিং
BOOKING_MAX_PER_PHONE_PER_DAY=2
# একই IP থেকে ঘণ্টায় সর্বোচ্চ কয়টি বুকিং
BOOKING_MAX_PER_IP_PER_HOUR=5

##############################################
#  বাহ্যিক সেবা (সবগুলোই ঐচ্ছিক)
##############################################
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"
